# Base site URL used for metadata, RSS feeds, and OG tags
NEXT_PUBLIC_BASE_URL=https://www.design-prism.com

# Override the default GA4 property (falls back to G-P9VY77PRC0 if empty)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion label for COMPLETED PURCHASES (the $300 website order),
# e.g. "AbC-D_efGh". Just the label — the AW- account id is added in code.
# Create it in Google Ads > Goals > Conversions > New conversion action >
# Website > Purchase, then paste the label here and in Vercel's env settings.
# Leave empty and the GA4 `purchase` event still fires; only the Ads-side
# purchase conversion is skipped, so leads and sales stay indistinguishable to
# Smart Bidding. See docs/analytics.md.
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# Optional custom endpoint for the scholarship form (defaults to Formspree)
NEXT_PUBLIC_SCHOLARSHIP_FORM_ENDPOINT=https://formspree.io/f/mwpwwjek
# Optional custom endpoint for the free AEO assessment form (defaults to Formspree)
NEXT_PUBLIC_AEO_FORM_ENDPOINT=https://formspree.io/f/xldarokj
# Optional custom endpoint for the Founder OS application form (defaults to Formspree)
NEXT_PUBLIC_FOUNDER_OS_FORM_ENDPOINT=https://formspree.io/f/xkoalapv
# Optional custom endpoint for the main Prism application form (defaults to Formspree)
NEXT_PUBLIC_APPLY_FORM_ENDPOINT=https://formspree.io/f/mreroojo

# Referral form (/refer), $100 program.
NEXT_PUBLIC_REFERRAL_FORM_ENDPOINT=https://formspree.io/f/meebpgaj
# Website intake form (/website-intake), the focused PRO-website lead funnel.
# Temporary fallback: the existing Prism "Website Customer Request" form.
# A developer with Formspree access should create a dedicated Website Intake
# form, paste that endpoint here and in Vercel Production + Preview, then
# update the hardcoded fallback in components/forms/WebsiteIntakeForm.tsx.
# See docs/forms.md (Formspree dashboard handoff).
NEXT_PUBLIC_WEBSITE_INTAKE_FORM_ENDPOINT=https://formspree.io/f/xpqebnbz
# Preferred endpoint for the Prism dashboard intake API. When set, /apply creates
# a client dashboard immediately and the dashboard app may mirror to Formspree.
NEXT_PUBLIC_DASHBOARD_INTAKE_ENDPOINT=
# Backward-compatible fallback name for older get-started form configs
NEXT_PUBLIC_GET_STARTED_FORM_ENDPOINT=
# Optional public override for the stock ElevenLabs agent used by the floating
# `/pricing` + `/contact` launcher and the inline homepage Prism Guide.
# Falls back to Prism Sales (agent_4701kkcyc4efefkv5x4awhysjyrh) when unset.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Optional comma-separated host allowlist for clickable markdown links inside ElevenLabs widgets.
# Defaults include Prism pages plus trusted booking hosts like calendar.notion.so and cal.com.
NEXT_PUBLIC_ELEVENLABS_MARKDOWN_LINK_ALLOWED_HOSTS=
# Opt-in for the homepage's consent-gated, inline Prism Guide on supported desktop browsers.
# The code default is false; production may enable it only after the first-party consent gate
# and Prism Privacy/Terms disclosures are live. Audit native ElevenLabs Terms and retention separately.
NEXT_PUBLIC_ELEVENLABS_HOMEPAGE_ENABLED=false
# Optional public kill switch for debugging or deterministic visual builds.
# Leave unset in normal development so the stock ElevenLabs widgets mount as expected.
NEXT_PUBLIC_ELEVENLABS_WIDGET_DISABLED=

# Prism Library social API credentials
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
TIKTOK_ACCESS_TOKEN=

# Used by deployment verification scripts
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_VERCEL_URL=
